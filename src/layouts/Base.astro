---
import "../styles/global.css"

interface Props {
	title: string
}
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title} — CIS 1912: DevOps</title>
	</head>
	<body class="bg-white text-gray-900 antialiased">
		<header class="border-b border-gray-200">
			<div class="mx-auto flex h-14 max-w-4xl items-center gap-6 px-6">
				<a
					href="/lectures"
					class="flex shrink-0 items-center gap-2 text-sm font-bold text-gray-900 hover:text-blue-600"
				>
					<img src="/logo.png" alt="" class="h-7 w-auto" />
					CIS 1912: DevOps
				</a>
				<nav class="flex flex-wrap items-center gap-x-5 gap-y-1">
					<a href="/lectures" class="text-sm text-gray-500 hover:text-blue-600"
						>Schedule</a
					>
					<a href="/homework" class="text-sm text-gray-500 hover:text-blue-600"
						>Homework</a
					>
					<a href="/syllabus" class="text-sm text-gray-500 hover:text-blue-600"
						>Syllabus</a
					>
					<a
						href="https://www.gradescope.com/courses/1381830"
						target="_blank"
						rel="noopener"
						class="text-sm text-gray-500 hover:text-blue-600">Gradescope</a
					>
					<a
						href="https://edstem.org/us/courses/103705/discussion"
						target="_blank"
						rel="noopener"
						class="text-sm text-gray-500 hover:text-blue-600">Ed</a
					>
				</nav>
			</div>
		</header>
		<main class="mx-auto max-w-4xl px-6 py-10">
			<slot />
		</main>
		<footer
			class="border-t border-gray-200 py-5 text-center text-xs text-gray-400"
		>
			CIS 1912: DevOps &mdash; University of Pennsylvania
		</footer>
	</body>
</html>
